[Desktop Entry]
Type=Application
Name=R2 dome tracker view
Comment=Camera view of the dome tracker, full screen on the monitor
# Waits for the tracker's web page, then opens it full screen (Alt+F4 closes it).
Exec=sh -c 'until curl -s -o /dev/null http://localhost:8080/; do sleep 2; done; chromium --ozone-platform=wayland --kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic http://localhost:8080/'
X-GNOME-Autostart-enabled=true
